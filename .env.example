# Browser-safe values
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
VITE_DEMO_MODE=false

# Public URL used by payment return URLs
APP_URL=https://your-domain.example

# AI Studio / Gemini (only if the AI features are enabled)
GEMINI_API_KEY=YOUR_GEMINI_KEY

# Supabase Edge Function secrets: set these in Supabase Secrets, never in VITE_*.
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# MERCADOPAGO_WEBHOOK_SECRET=...
# SUPABASE_SERVICE_ROLE_KEY=...
# CREATOR_SHARE_PERCENT=85

# Provider-neutral production adapters (server-side only; examples, not provider selections)
# AGE_VERIFICATION_PROVIDER=
# AGE_VERIFICATION_WEBHOOK_SECRET=
# PAYMENT_PROVIDER=
# STREAMING_PROVIDER=
# STREAMING_API_KEY=
# STREAMING_ALLOWED_HOSTS=stream.example.com,cdn.example.com
# MODERATION_PROVIDER=
# MODERATION_API_KEY=
# OBSERVABILITY_DSN=
# ALLOWED_ORIGINS=https://your-domain.example
